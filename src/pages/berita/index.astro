---
import { getAllBlogPosts, BlogApiError } from '../../lib/blog';
import Layout from '../../layouts/Layout.astro';

let error: string | null = null;
let sortedPosts: any[] = [];

try {
  const allPosts = await getAllBlogPosts();
  sortedPosts = allPosts.sort((a, b) =>
    new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf()
  );
} catch (err) {
  if (err instanceof BlogApiError) {
    error = err.message;
  } else {
    error = 'Terjadi kesalahan saat memuat artikel. Silakan coba lagi nanti.';
  }
  console.error('[berita/index] Error:', err);
}
---

<Layout title="Berita | UNO JERSEY" showPreloader={false}>
  <div class="blog-container">
    <header class="blog-header">
      <h1 class="blog-title">Berita</h1>
      <p class="blog-subtitle">
        Artikel, tips, dan informasi seputar jersey custom untuk tim dan komunitas Anda
      </p>
    </header>

    {error ? (
      <div class="error-state">
        <div class="error-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
        </div>
        <h2 class="error-title">Gagal Memuat Artikel</h2>
        <p class="error-message">{error}</p>
        <div class="error-actions">
          <button onclick="location.reload()" class="btn-retry">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Coba Lagi
          </button>
          <a href="/" class="btn-home">Kembali ke Beranda</a>
        </div>
      </div>
    ) : sortedPosts.length === 0 ? (
      <div class="error-state">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h2 class="error-title">Belum Ada Artikel</h2>
        <p class="error-message">Artikel sedang disiapkan. Silakan kunjungi kembali nanti.</p>
        <a href="/" class="btn-retry">Kembali ke Beranda</a>
      </div>
    ) : (
      <>
    <div class="blog-grid" id="blogGrid">
      {sortedPosts.slice(0, 6).map((post, index) => (
        <article class="blog-card loaded" data-index={index}>
          <a href={`/berita/${post.slug}/`} class="blog-card-link">
            {post.image && (
              <div class="blog-card-image">
                <img
                  data-src={post.image}
                  alt={post.title}
                  class="lazy-img"
                />
                <div class="skeleton-image"></div>
              </div>
            )}
            <div class="blog-card-content">
              <div class="blog-card-meta">
                <time datetime={post.pubDate}>
                  {new Date(post.pubDate).toLocaleDateString('id-ID', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                {post.category && (
                  <>
                    <span class="meta-separator">•</span>
                    <span class="category">{post.category}</span>
                  </>
                )}
              </div>
              <h2 class="blog-card-title">
                {post.title}
              </h2>
              <p class="blog-card-excerpt">
                {post.excerpt}
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>

    {sortedPosts.length > 6 && (
      <div class="load-more-container">
        <button class="load-more-btn" id="loadMoreBtn">
          Muat Lebih Banyak
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 5v14M5 12l7 7 7-7"/>
          </svg>
        </button>
      </div>
    )}
    </>
    )}
  </div>

  <script define:vars={{ sortedPosts }}>
    (function() {
      'use strict';

      const lazyLoadImages = () => {
        const imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              const src = img.getAttribute('data-src');
              if (src) {
                img.onload = () => {
                  img.classList.add('loaded');
                  const skeleton = img.parentElement?.querySelector('.skeleton-image');
                  if (skeleton) {
                    skeleton.style.opacity = '0';
                    setTimeout(() => skeleton.remove(), 300);
                  }
                };
                img.src = src;
                observer.unobserve(img);
              }
            }
          });
        }, { rootMargin: '50px', threshold: 0.1 });
        document.querySelectorAll('.lazy-img').forEach(img => imageObserver.observe(img));
      };

      if ('IntersectionObserver' in window) {
        lazyLoadImages();
      } else {
        document.querySelectorAll('.lazy-img').forEach(img => {
          const src = img.getAttribute('data-src');
          if (src) { img.src = src; img.classList.add('loaded'); }
        });
      }

      const blogGrid = document.getElementById('blogGrid');
      const loadMoreBtn = document.getElementById('loadMoreBtn');
      if (!loadMoreBtn) return;

      let currentPage = 1;
      const postsPerPage = 6;
      const totalPosts = sortedPosts.length;
      const totalPages = Math.ceil(totalPosts / postsPerPage);

      const createSkeletonCard = () => {
        const article = document.createElement('article');
        article.className = 'blog-card skeleton';
        article.innerHTML = `
          <div class="blog-card-link">
            <div class="blog-card-image">
              <div class="skeleton-image" style="position: absolute; inset: 0;"></div>
            </div>
            <div class="blog-card-content">
              <div class="skeleton-meta"></div>
              <div class="skeleton-title"></div>
              <div class="skeleton-title"></div>
              <div class="skeleton-excerpt"></div>
              <div class="skeleton-excerpt"></div>
              <div class="skeleton-excerpt"></div>
            </div>
          </div>
        `;
        return article;
      };

      loadMoreBtn.addEventListener('click', function() {
        currentPage++;
        loadMoreBtn.disabled = true;
        loadMoreBtn.innerHTML = `<span class="spinner"></span> Memuat...`;

        const startIndex = currentPage * postsPerPage;
        const endIndex = startIndex + postsPerPage;
        const postsToShow = sortedPosts.slice(startIndex, endIndex);

        const skeletons = [];
        postsToShow.forEach(() => {
          const skeleton = createSkeletonCard();
          blogGrid.appendChild(skeleton);
          skeletons.push(skeleton);
        });

        setTimeout(() => {
          skeletons.forEach((skeleton, index) => {
            const post = postsToShow[index];
            if (!post) return;

            const article = document.createElement('article');
            article.className = 'blog-card loaded';
            article.style.opacity = '0';
            article.style.transform = 'translateY(20px)';

            article.innerHTML = `
              <a href="/berita/${post.slug}/" class="blog-card-link">
                ${post.image ? `
                  <div class="blog-card-image">
                    <img data-src="${post.image}" alt="${post.title}" class="lazy-img" />
                    <div class="skeleton-image"></div>
                  </div>
                ` : ''}
                <div class="blog-card-content">
                  <div class="blog-card-meta">
                    <time datetime="${post.pubDate}">
                      ${new Date(post.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    ${post.category ? `<span class="meta-separator">•</span><span class="category">${post.category}</span>` : ''}
                  </div>
                  <h2 class="blog-card-title">${post.title}</h2>
                  <p class="blog-card-excerpt">${post.excerpt}</p>
                </div>
              </a>
            `;

            blogGrid.replaceChild(article, skeleton);

            const newImg = article.querySelector('.lazy-img');
            if (newImg && 'IntersectionObserver' in window) {
              const imageObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    const img = entry.target;
                    const src = img.getAttribute('data-src');
                    if (src) {
                      img.onload = () => { img.classList.add('loaded'); };
                      img.src = src;
                      observer.unobserve(img);
                    }
                  }
                });
              }, { rootMargin: '50px', threshold: 0.1 });
              imageObserver.observe(newImg);
            } else if (newImg) {
              const src = newImg.getAttribute('data-src');
              if (src) { newImg.src = src; newImg.classList.add('loaded'); }
            }

            setTimeout(() => {
              article.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
              article.style.opacity = '1';
              article.style.transform = 'translateY(0)';
              setTimeout(() => { article.style.transition = ''; article.style.opacity = ''; article.style.transform = ''; }, 500);
            }, index * 100);
          });

          if (currentPage >= totalPages) {
            loadMoreBtn.style.display = 'none';
          } else {
            loadMoreBtn.disabled = false;
            loadMoreBtn.innerHTML = `Muat Lebih Banyak <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>`;
          }
        }, 300);
      });
    })();
  </script>
</Layout>

<style>
  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 20px 40px;
    min-height: 100vh;
  }

  .blog-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .blog-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 400;
    color: #1a1a1a;
    letter-spacing: 0.02em;
    margin-bottom: 16px;
  }

  .blog-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 32px;
    margin-top: 40px;
  }

  .blog-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-card.loaded:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
  }

  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .blog-card-image {
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: #f5f5f5;
    position: relative;
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-card-image img.loaded {
    opacity: 1;
  }

  .blog-card.loaded:hover .blog-card-image img.loaded {
    transform: scale(1.05);
  }

  .skeleton-image {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    transition: opacity 0.3s ease;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .blog-card-content {
    padding: 24px;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #888;
    margin-bottom: 12px;
  }

  .meta-separator { color: #ccc; }

  .category {
    color: #1a1a1a;
    font-weight: 500;
    text-transform: capitalize;
  }

  .blog-card-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    font-weight: 400;
    color: #1a1a1a;
    letter-spacing: 0.02em;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .blog-card-excerpt {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #666;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .skeleton { pointer-events: none; }
  .skeleton-meta { width: 120px; height: 14px; background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 4px; margin-bottom: 12px; }
  .skeleton-title { width: 100%; height: 28px; background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 4px; margin-bottom: 8px; }
  .skeleton-excerpt { width: 100%; height: 14px; background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 4px; margin-bottom: 6px; }
  .skeleton-excerpt:last-child { width: 70%; }

  .load-more-container { display: flex; justify-content: center; margin-top: 60px; }

  .load-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    background: #E63946;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .load-more-btn:hover:not(:disabled) {
    background: #c1121f;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(230, 57, 70, 0.3);
  }

  .load-more-btn:disabled { opacity: 0.7; cursor: not-allowed; }
  .load-more-btn:active { transform: translateY(0); }
  .load-more-btn svg { transition: transform 0.3s ease; }
  .load-more-btn:hover:not(:disabled) svg { transform: translateY(2px); }

  .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* Error & Empty State */
  .error-state {
    text-align: center;
    padding: 80px 20px;
  }

  .error-icon, .empty-icon {
    width: 96px;
    height: 96px;
    margin: 0 auto 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-icon {
    background: #fef2f2;
    color: #f87171;
  }

  .empty-icon {
    background: #eff6ff;
    color: #60a5fa;
  }

  .error-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    color: #1a1a1a;
    margin-bottom: 12px;
    letter-spacing: 0.02em;
  }

  .error-message {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #666;
    max-width: 400px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-retry {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: #E63946;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .btn-retry:hover {
    background: #c1121f;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(230, 57, 70, 0.3);
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    background: transparent;
    color: #1a1a1a;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    border: 2px solid #e5e5e5;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .btn-home:hover {
    border-color: #1a1a1a;
    background: #fafafa;
  }

  @media (max-width: 768px) {
    .blog-container { padding: 60px 16px 30px; }
    .blog-title { font-size: 40px; }
    .blog-subtitle { font-size: 16px; }
    .blog-grid { grid-template-columns: 1fr; gap: 24px; }
    .blog-card-image { height: 200px; }
    .blog-card-content { padding: 20px; }
    .blog-card-title { font-size: 24px; }
    .load-more-btn { padding: 14px 28px; font-size: 15px; }
  }
</style>

---
/**
 * UNO JERSEY - KREASIKAN Layout
 * Minimal layout for the jersey customization app
 */

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kreasikan Jersey Custom | UNO JERSEY',
  description = 'Buat jersey custom sesuai desainmu dengan UNO JERSEY jersey editor.'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageAbsolute = new URL('/images/og-image.jpg', Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="UNO JERSEY" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#E63946" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Tailwind CSS for KREASIKAN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- html2canvas for export -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <!-- Google tag (gtag.js) -->
    <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-HWXXE5WFQL"></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID: 'G-HWXXE5WFQL' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HWXXE5WFQL');
    </script>
  </head>
  <body class="bg-gray-100 font-['Inter']">
    <slot />
  </body>
</html>

<style is:global>
  /* KREASIKAN specific styles override */
  body {
    margin: 0;
    padding: 0;
  }
</style>
